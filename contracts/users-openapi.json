              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing, invalid or revoked credentials"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "409": {
            "description": "Conflicting version or existing profile"
          },
          "413": {
            "description": "Body exceeds 16 KiB"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "Required service unavailable"
          }
        },
        "requestBody": {
          "required": true,
