  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token"
      }
    },
    "schemas": {
      "Gender": {
        "type": "string",
        "enum": [
          "MALE",
          "FEMALE",
          "NON_BINARY",
          "OTHER"
        ]
      },
      "SearchMode": {
        "type": "string",
        "enum": [
          "DATING",
          "FRIENDS",
          "ACTIVITIES",
          "ANY"
        ]
      },
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "Privacy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "discoverable": {
            "type": "boolean"
          },
          "showDistance": {
            "type": "boolean"
          },
          "showLastSeen": {
            "type": "boolean"
          }
        },
        "required": [
          "discoverable",
          "showDistance",
          "showLastSeen"
        ]
      },
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minAge": {
            "type": "integer",
            "minimum": 18,
            "maximum": 120
          },
          "maxAge": {
            "type": "integer",
            "minimum": 18,
            "maximum": 120
          },
          "maxDistanceKm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "preferredGenders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gender"
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          },
          "selectedModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchMode"
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "minAge",
          "maxAge",
          "maxDistanceKm",
          "preferredGenders",
          "selectedModes"
        ]
      },
      "CreateProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "description": "Age 18–120. Immutable after onboarding."
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "searchModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchMode"
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "nickname",
          "birthDate",
          "gender",
          "searchModes"
        ]
      },
      "PatchProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "relationshipGoal": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "searchModes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SearchMode"
                },
                "maxItems": 4,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "version"
        ]
      },
      "Interest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "category"
        ]
      },
      "Interests": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 15,
            "uniqueItems": true
          }
        },
        "required": [
          "interests"
        ]
      },
      "Photos": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 6,
            "uniqueItems": true
          }
        },
        "required": [
          "mediaIds"
        ]
      },
      "Access": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "type": "boolean"
          }
        },
        "required": [
          "allowed"
        ]
      },
      "Pair": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "viewerId": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "viewerId",
          "targetId"
        ]
      },
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "viewerId": {
            "type": "string",
            "format": "uuid"
          },
          "userIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "viewerId",
          "userIds"
        ]
      },
      "PhotoAccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "viewerId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "mediaId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "viewerId",
          "ownerId",
          "mediaId"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "FAKE_PROFILE",
              "HARASSMENT",
              "SPAM",
              "INAPPROPRIATE_CONTENT",
              "UNDERAGE",
              "OTHER"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "targetId",
          "reason",
          "description"
        ]
      },
      "StoredReport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reporterId": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "reporterId",
          "targetId",
          "reason",
          "description",
          "createdAt"
        ]
      },
      "MyProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "bio": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "relationshipGoal": {
            "type": "string"
          },
          "searchModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchMode"
            }
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "verified": {
            "type": "boolean"
          },
          "lastSeen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "privacy": {
            "$ref": "#/components/schemas/Privacy"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "nickname",
          "gender",
          "bio",
          "city",
          "relationshipGoal",
          "searchModes",
          "interests",
          "photos",
          "verified",
          "lastSeen",
          "birthDate",
          "location",
          "preferences",
          "privacy",
          "createdAt",
          "version",
          "deleted"
        ]
      },
      "PublicProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "bio": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "relationshipGoal": {
            "type": "string"
          },
          "searchModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchMode"
            }
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "verified": {
            "type": "boolean"
          },
          "lastSeen": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "age": {
            "type": "integer"
          },
          "online": {
            "type": "boolean"
          },
          "distanceKm": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 5,
                "description": "Upper bound of a 5 km distance bucket."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "nickname",
          "gender",
          "bio",
          "city",
          "relationshipGoal",
          "searchModes",
          "interests",
          "photos",
          "verified",
          "lastSeen",
          "age",
          "online",
          "distanceKm"
        ]
      }
    }
  }
}
